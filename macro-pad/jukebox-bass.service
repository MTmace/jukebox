# Jukebox bass knob. A "user" service: it runs as mtmace when the desktop
# logs in, so it can reach PipeWire. Installed by install-bass.sh to
# ~/.config/systemd/user/. Check it with:  systemctl --user status jukebox-bass
[Unit]
Description=Jukebox bass knob
After=pipewire.service wireplumber.service

[Service]
ExecStart=/usr/bin/python3 %h/fruitbox/jukebox-bass.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
